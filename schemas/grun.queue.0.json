{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grun.queue/0",
  "title": "grun.queue/0 (provisional, no fingerprint: D-13)",
  "description": "The queue.json of an application and the entry views of /api/queue. Entries accept the old shape (only id, position, state and enqueuedAt are required) and any field of the application.",
  "type": "object",
  "required": ["nextId", "entries"],
  "properties": {
    "nextId": {"type": "integer", "minimum": 1},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"},
    "error": {
      "type": "object",
      "required": ["code", "params"],
      "properties": {
        "code": {"type": "string"},
        "params": {"type": "object"},
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "code", "params"],
            "properties": {"path": {"type": "string"}, "code": {"type": "string"}, "params": {"type": "object"}}
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "position", "state", "enqueuedAt"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "position": {"type": "integer", "minimum": 1},
        "state": {"enum": ["queued", "running", "done", "failed", "cancelled"]},
        "pid": {"type": ["integer", "null"]},
        "enqueuedAt": {"$ref": "#/$defs/timestamp"},
        "startedAt": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "finishedAt": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "error": {"oneOf": [{"$ref": "#/$defs/error"}, {"type": "null"}]},
        "cancelRequested": {"type": "boolean"},
        "orphanCount": {"type": "integer", "minimum": 0},
        "batch": {
          "type": "object",
          "required": ["id", "index", "size"],
          "properties": {
            "id": {"type": "integer", "minimum": 1},
            "index": {"type": "integer", "minimum": 0},
            "size": {"type": "integer", "minimum": 1}
          }
        },
        "progress": {
          "type": "object",
          "required": ["step", "steps", "etaS"],
          "properties": {
            "step": {"type": "integer", "minimum": 0},
            "steps": {"type": "integer", "minimum": 1},
            "etaS": {"type": ["number", "null"], "minimum": 0}
          }
        },
        "preview": {"type": "string"}
      }
    },
    "view": {
      "allOf": [
        {"$ref": "#/$defs/entry"},
        {
          "properties": {
            "held": {"type": "string"},
            "estimateMs": {"type": "number", "minimum": 0},
            "errorText": {"type": "string"}
          }
        }
      ]
    },
    "list": {"type": "array", "items": {"$ref": "#/$defs/view"}},
    "entries": {
      "type": "object",
      "required": ["entries"],
      "properties": {"entries": {"$ref": "#/$defs/list"}}
    },
    "pause": {
      "type": "object",
      "required": ["paused", "changed"],
      "properties": {"paused": {"type": "boolean"}, "changed": {"type": "boolean"}}
    },
    "health": {
      "type": "object",
      "required": ["ok", "api", "version", "pid", "port", "paused", "worker"],
      "properties": {
        "ok": {"const": true},
        "api": {"type": "integer", "minimum": 1},
        "version": {"type": "string"},
        "pid": {"type": "integer"},
        "port": {"type": "integer"},
        "paused": {"type": "boolean"},
        "worker": {"type": "boolean"}
      }
    },
    "apiError": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "allOf": [
            {"$ref": "#/$defs/error"},
            {"required": ["message"], "properties": {"message": {"type": "string"}}}
          ]
        }
      }
    }
  }
}
